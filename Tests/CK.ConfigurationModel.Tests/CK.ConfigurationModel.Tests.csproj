<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The documentation of the models is read from the Xml documentation file (not generated for tests by default). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CK.Testing.Nunit" Version="18.0.0-0.uc.1" />
    <!-- Compiles the code generated by the ConfigurationModelCodeWriter. -->
    <PackageReference Include="CK.CodeGen.Roslyn" Version="18.0.0-0.uc.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\CK.ConfigurationModel.Engine\CK.ConfigurationModel.Engine.csproj" />
  </ItemGroup>
</Project>
