<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- The rules are documented in the README of CK.ConfigurationModel, not tracked in release files. -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <!-- Shipped inside the CK.ConfigurationModel package (analyzers/dotnet/cs), never as a package of its own. -->
    <IsPackable>false</IsPackable>
    <Description>The source generator of the configuration models of CK.ConfigurationModel.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
